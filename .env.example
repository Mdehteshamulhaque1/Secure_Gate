# Backend Environment Variables
# Copy to .env for local development
# In Render: Service → Environment → Add each variable

# Security (REQUIRED in production)
SECRET_KEY=your-super-secret-key-generate-with-openssl-rand-base64-32
DJANGO_DEBUG=False

# Hosts (comma-separated, no spaces)
ALLOWED_HOSTS=.onrender.com,your-custom-domain.com

# CORS / CSRF for frontend (Vercel)
# Example: https://securegate.vercel.app
CSRF_TRUSTED_ORIGINS=https://your-vercel-app.vercel.app
CORS_ALLOWED_ORIGINS=https://your-vercel-app.vercel.app

# Database (auto-provided by Render PostgreSQL)
# DATABASE_URL=postgresql://user:pass@host:port/dbname

# Optional: Email (production)
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=your-smtp-user
# EMAIL_HOST_PASSWORD=your-smtp-password
# EMAIL_USE_TLS=True
# DEFAULT_FROM_EMAIL=SecureGate <no-reply@yourdomain.com>