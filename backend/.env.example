# Backend Environment Variables — copy to backend/.env for local development
# In Render: Service → Environment → add each variable (or paste .env)

# ---------------------------------------------------------------------------
# Django core
# ---------------------------------------------------------------------------

# SECURITY: generate a strong key, e.g.  python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=your-super-secret-key-change-me

# "True" enables debug / local-friendly settings. MUST be "False" in production.
DJANGO_DEBUG=True

# Runtime environment: "development" (default) or "production".
# In production, DATABASE_URL is required — there is no SQLite fallback.
DJANGO_ENV=development

# Comma-separated, no spaces
ALLOWED_HOSTS=127.0.0.1,localhost,.onrender.com

# CORS / CSRF for the Vercel frontend (comma-separated)
CSRF_TRUSTED_ORIGINS=https://your-vercel-app.vercel.app
CORS_ALLOWED_ORIGINS=https://your-vercel-app.vercel.app

# ---------------------------------------------------------------------------
# Supabase (PostgreSQL only — no Supabase Auth, Storage, or JS client)
# ---------------------------------------------------------------------------
# From Supabase Dashboard → Project Settings → Database → Connection string
# Select "Session pooler" (or "Direct connection") — PostgreSQL, port 5432.
# Replace the placeholders below with YOUR project values. Never commit this
# file with a real password; keep the trailing ?sslmode=require.
# Example only (no real credentials):
#   DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=

# Optional: force TLS mode for Postgres (defaults to "require" in settings.py)
# POSTGRES_SSL_MODE=require

# ---------------------------------------------------------------------------
# Email (SMTP) — required to send the QR pass to visitors on approval.
# Defaults to the console backend (prints emails to logs) until EMAIL_HOST_USER
# is set. For Gmail: use an App Password (Google account → Security → 2-Step
# Verification → App passwords); your normal password will NOT work.
# ---------------------------------------------------------------------------
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=SecureGate <no-reply@securegate.io>
